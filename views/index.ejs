<%- include('partials/head', { page }) %>
<%- include('partials/header') %>

<!-- ============================ HERO ============================ -->
<section class="hero" id="accueil">
  <div class="hero-bg parallax" aria-hidden="true">
    <div class="hero-glow hero-glow-1 parallax-layer" data-speed="0.10"></div>
    <div class="hero-glow hero-glow-2 parallax-layer" data-speed="0.06"></div>
  </div>
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow reveal"><span class="eyebrow-dot" aria-hidden="true"></span>AGENCE DIGITALE • WEB &amp; IA</p>
      <h1 class="hero-title reveal">
        <%= BRAND.sloganA %><br>
        Construisez <span class="text-red">votre avenir</span>.
      </h1>
      <p class="hero-sub reveal"><%= BRAND.intro %></p>
      <div class="hero-actions reveal">
        <a href="#services" class="btn btn-primary">Découvrir nos services
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a href="/commander" class="btn btn-ghost">Parler de mon projet</a>
      </div>
      <ul class="hero-trust reveal" aria-label="Nos engagements">
        <li>
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Devis clair, sans surprise
        </li>
        <li>
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Brief guidé par IA après commande
        </li>
        <li>
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Périmètre défini par écrit
        </li>
      </ul>
    </div>
    <div class="hero-visual reveal">
      <picture>
        <source type="image/webp" srcset="/assets/hero-laptop.webp<%= typeof assetV !== 'undefined' ? '?v=' + assetV : '' %>">
        <img src="/assets/hero-laptop.png<%= typeof assetV !== 'undefined' ? '?v=' + assetV : '' %>" alt="Ordinateur portable affichant un site web haut de gamme en thème sombre avec accents rouges" width="1376" height="768" fetchpriority="high" decoding="async">
      </picture>
    </div>
  </div>
</section>

<!-- ============================ SERVICES ============================ -->
<section class="section" id="services">
  <div class="container">
    <header class="section-head reveal">
      <p class="eyebrow">NOS SERVICES</p>
      <h2>Des solutions digitales pensées pour <span class="text-red">votre croissance</span>.</h2>
      <p class="section-sub">Nous concevons des sites web modernes et performants, et intégrons des solutions IA sur mesure pour améliorer vos opérations.</p>
    </header>
    <div class="cards-3">
      <% SERVICES.forEach(function(s){ %>
      <article class="card service-card tilt-3d reveal-3d spotlight">
        <div class="card-icon" aria-hidden="true">
          <% if (s.icon === 'code') { %>
            <svg viewBox="0 0 24 24"><path d="m8 6-6 6 6 6M16 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <% } else if (s.icon === 'brain') { %>
            <svg viewBox="0 0 24 24"><path d="M9.5 3A3.5 3.5 0 0 0 6 6.5c0 .2 0 .4.03.6A3.5 3.5 0 0 0 4 10.5c0 1 .42 1.9 1.08 2.53A3.5 3.5 0 0 0 7.5 19H9a2 2 0 0 0 2-2V5.5A2.5 2.5 0 0 0 9.5 3Zm5 0A3.5 3.5 0 0 1 18 6.5c0 .2 0 .4-.03.6A3.5 3.5 0 0 1 20 10.5c0 1-.42 1.9-1.08 2.53A3.5 3.5 0 0 1 16.5 19H15a2 2 0 0 1-2-2V5.5A2.5 2.5 0 0 1 14.5 3Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <% } else { %>
            <svg viewBox="0 0 24 24"><path d="M13 2 4.5 13.5H11L9.5 22 19 10h-6.5L13 2Z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <% } %>
        </div>
        <h3><a href="<%= s.link || '/commander' %>"><%= s.title %></a></h3>
        <p class="muted"><%= s.text %></p>
        <a class="link-arrow" href="/commander">Discuter de ce besoin
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </article>
      <% }); %>
    </div>
  </div>
</section>

<!-- ============================ POURQUOI ============================ -->
<section class="section section-alt" id="pourquoi">
  <div class="container">
    <header class="section-head reveal">
      <p class="eyebrow">POURQUOI DIGITALVERSE</p>
      <h2>Une approche premium, <span class="text-red">orientée résultats</span>.</h2>
    </header>
    <div class="cards-4">
      <% AVANTAGES.forEach(function(a){ %>
      <article class="card why-card tilt-3d reveal-3d spotlight">
        <div class="card-icon sm" aria-hidden="true">
          <% if (a.icon === 'pen') { %>
            <svg viewBox="0 0 24 24"><path d="M12 19h8M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5Z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <% } else if (a.icon === 'target') { %>
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.7"/><circle cx="12" cy="12" r="5" fill="none" stroke="currentColor" stroke-width="1.7"/><circle cx="12" cy="12" r="1.4" fill="currentColor"/></svg>
          <% } else if (a.icon === 'devices') { %>
            <svg viewBox="0 0 24 24"><rect x="2" y="5" width="14" height="10" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="M6 19h8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><rect x="17" y="9" width="5" height="10" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.7"/></svg>
          <% } else { %>
            <svg viewBox="0 0 24 24"><path d="M12 3 4.5 6v5.5c0 4.5 3 7.9 7.5 9.5 4.5-1.6 7.5-5 7.5-9.5V6L12 3Z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="m9 12 2 2 4-4" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <% } %>
        </div>
        <h3><%= a.title %></h3>
        <p class="muted"><%= a.text %></p>
      </article>
      <% }); %>
    </div>
  </div>
</section>

<!-- ============================ EXPERTISES (SEO : H2 par service + maillage interne) ============================ -->
<section class="section" id="expertises">
  <div class="container">
    <header class="section-head reveal">
      <p class="eyebrow">NOS EXPERTISES</p>
      <h2>Création de site internet, chatbot IA et automatisation pour <span class="text-red">PME</span>.</h2>
      <p class="section-sub">Une agence web et IA pour les entreprises qui veulent un site clair, un assistant utile et moins de tâches répétitives. Chaque service détaille son périmètre, ses tarifs et ses limites.</p>
    </header>
    <div class="cards-3">
      <% (LANDING_PAGES || []).slice(0, 4).forEach(function(lp){ %>
      <article class="card service-card reveal">
        <h3><a href="<%= lp.path %>"><%= lp.nav %></a></h3>
        <p class="muted"><%= lp.metaDescription %></p>
        <a class="link-arrow" href="<%= lp.path %>">En savoir plus sur la <%= lp.nav.toLowerCase() %></a>
      </article>
      <% }); %>
    </div>
    <div class="reveal" style="margin-top:2rem">
      <h3>Guides pour bien démarrer</h3>
      <ul>
        <% (GUIDES || []).forEach(function(g){ %>
        <li><a href="/guides/<%= g.slug %>"><%= g.title %></a></li>
        <% }); %>
        <li><a href="/maintenance-site-internet">Maintenance de site internet</a></li>
        <li><a href="/guides">Tous nos guides</a></li>
      </ul>
    </div>
  </div>
</section>

<!-- ============================ OFFRES ============================ -->
<section class="section" id="offres">
  <div class="container">
    <header class="section-head reveal">
      <p class="eyebrow">NOS OFFRES</p>
      <h2>Des offres claires, <span class="text-red">adaptées à vos besoins</span>.</h2>
      <p class="section-sub">Chaque offre précise son périmètre. Ce qui n’est pas indiqué n’est pas inclus : tout est confirmé par devis, sans surprise.</p>
    </header>

    <div class="pricing-tabs reveal" role="tablist" aria-label="Catégories d'offres">
      <button class="pricing-tab active" role="tab" aria-selected="true" aria-controls="offres-site" id="tab-site">Sites web</button>
      <button class="pricing-tab" role="tab" aria-selected="false" aria-controls="offres-agent" id="tab-agent">Agents IA</button>
      <span class="pricing-tab-slider" aria-hidden="true"></span>
    </div>

    <div class="pricing-grid" id="offres-site" role="tabpanel" aria-labelledby="tab-site">
      <% ['vitrine-starter','vitrine-care','business-fonctionnel','business-care'].forEach(function(slug){ const p = PLANS[slug]; %>
      <article class="card price-card tilt-3d reveal-3d spotlight <%= p.recommended ? 'recommended' : '' %>">
        <% if (p.recommended) { %><span class="badge-reco">Recommandée</span><% } %>
        <h3><%= p.name %></h3>
        <p class="price"><span class="price-amount"><% if (p.from) { %>dès <% } %><%= p.price.toLocaleString('fr-FR') %> €</span> <span class="price-unit"><%= p.unit %></span></p>
        <p class="muted small"><%= p.tagline %></p>
        <ul class="price-features">
          <% p.features.forEach(function(f){ %>
          <li>
            <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <%= f %>
          </li>
          <% }); %>
        </ul>
        <p class="price-note"><%= p.note %></p>
        <a href="/commander?offre=<%= slug %>" class="btn <%= p.recommended ? 'btn-primary' : 'btn-outline' %> btn-block"><%= p.cta %></a>
      </article>
      <% }); %>
    </div>

    <div class="pricing-grid pricing-grid-2 hidden" id="offres-agent" role="tabpanel" aria-labelledby="tab-agent" hidden>
      <% ['chatbot-ia','automatisation-ia'].forEach(function(slug){ const p = PLANS[slug]; %>
      <article class="card price-card tilt-3d reveal-3d spotlight <%= p.recommended ? 'recommended' : '' %>">
        <% if (p.recommended) { %><span class="badge-reco">Recommandée</span><% } %>
        <h3><%= p.name %></h3>
        <p class="price"><span class="price-amount"><% if (p.from) { %>dès <% } %><%= p.price.toLocaleString('fr-FR') %> €</span> <span class="price-unit"><%= p.unit %></span></p>
        <p class="muted small"><%= p.tagline %></p>
        <ul class="price-features">
          <% p.features.forEach(function(f){ %>
          <li>
            <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <%= f %>
          </li>
          <% }); %>
        </ul>
        <p class="price-note"><%= p.note %></p>
        <a href="/commander?offre=<%= slug %>" class="btn <%= p.recommended ? 'btn-primary' : 'btn-outline' %> btn-block"><%= p.cta %></a>
      </article>
      <% }); %>
    </div>
    <div class="pricing-notice reveal" role="note">
      <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 8v5m0 3h.01M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <p><%= SUBSCRIPTION_CANCELLATION_NOTE %></p>
    </div>
    <p class="pricing-note reveal"><%= PRICING_GLOBAL_NOTE %></p>
  </div>
</section>

<!-- ============================ RÉALISATIONS ============================ -->
<!-- ============================ PROCESSUS ============================ -->
<section class="section" id="processus">
  <div class="container">
    <header class="section-head reveal">
      <p class="eyebrow">NOTRE MÉTHODE</p>
      <h2>De l’idée <span class="text-red">à la mise en ligne</span>.</h2>
    </header>
    <ol class="timeline">
      <% PROCESSUS.forEach(function(s){ %>
      <li class="timeline-step reveal-3d">
        <span class="timeline-num" aria-hidden="true"><%= s.n %></span>
        <h3><%= s.title %></h3>
        <p class="muted"><%= s.text %></p>
      </li>
      <% }); %>
    </ol>
  </div>
</section>

<!-- ============================ À PROPOS ============================ -->
<section class="section section-alt" id="a-propos">
  <div class="container about-grid">
    <div class="reveal">
      <p class="eyebrow">À PROPOS</p>
      <h2>Une vision du digital tournée <span class="text-red">vers l’avenir</span>.</h2>
      <p>DigitalVerse est née d’une conviction : les entreprises méritent des outils digitaux à la hauteur de leur ambition. Pas des gabarits génériques, mais des sites pensés pour durer et des technologies vraiment utiles.</p>
      <p>Notre approche associe un design exigeant, un développement soigné et une intégration raisonnée de l’intelligence artificielle — là où elle apporte une vraie valeur : répondre plus vite, automatiser le répétitif, mieux servir vos clients.</p>
      <p>Chaque projet commence par un brief précis et se poursuit par un accompagnement transparent : des périmètres écrits, des tarifs annoncés, et une relation construite sur la durée.</p>
      <div class="about-actions">
        <a href="/commander" class="btn btn-primary">Démarrer un projet</a>
        <a href="#contact" class="btn btn-ghost">Nous contacter</a>
      </div>
    </div>
    <div class="about-visual reveal">
      <img src="/assets/logo-emblem.png" alt="Logo DigitalVerse" width="220" height="220" loading="lazy">
    </div>
  </div>
</section>

<!-- ============================ FAQ ============================ -->
<section class="section" id="faq">
  <div class="container faq-wrap">
    <header class="section-head reveal">
      <p class="eyebrow">QUESTIONS FRÉQUENTES</p>
      <h2>Tout ce que vous devez savoir, <span class="text-red">en toute transparence</span>.</h2>
    </header>
    <div class="faq-list reveal">
      <% FAQ.forEach(function(item, i){ %>
      <div class="faq-item">
        <button class="faq-q" aria-expanded="false" aria-controls="faq-a-<%= i %>" id="faq-q-<%= i %>">
          <span><%= item.q %></span>
          <svg class="icon chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="faq-a" id="faq-a-<%= i %>" role="region" aria-labelledby="faq-q-<%= i %>" hidden>
          <p><%= item.a %></p>
        </div>
      </div>
      <% }); %>
    </div>
  </div>
</section>

<!-- ============================ CONTACT ============================ -->
<section class="section section-alt" id="contact">
  <div class="container contact-grid">
    <div class="reveal">
      <p class="eyebrow">CONTACT</p>
      <h2>Parlons de <span class="text-red">votre projet</span>.</h2>
      <p class="section-sub">Expliquez-nous votre besoin et construisons ensemble une solution adaptée à votre entreprise.</p>
      <ul class="contact-points">
        <li>
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Réponse personnelle, sans robot
        </li>
        <li>
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Devis détaillé avant tout engagement
        </li>
        <li>
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M13 2 4.5 13.5H11L9.5 22 19 10h-6.5L13 2Z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>Vous préférez avancer tout de suite ? <a href="/commander">Commandez en ligne</a> et décrivez votre projet à notre assistant de brief.</span>
        </li>
      </ul>
      <p class="muted small">Vos informations servent uniquement à répondre à votre demande. Consultez notre <a href="/politique-de-confidentialite">politique de confidentialité</a>.</p>
    </div>
    <form class="card contact-form reveal" id="contact-form" novalidate>
      <div class="form-alert hidden" id="contact-success" role="status">
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <div><strong>Message bien reçu.</strong><br>Merci ! Nous étudions votre demande et revenons vers vous rapidement.</div>
      </div>
      <div class="form-row">
        <div class="form-field">
          <label for="c-name">Nom complet <span aria-hidden="true">*</span></label>
          <input type="text" id="c-name" name="name" autocomplete="name" required aria-describedby="c-name-err">
          <p class="field-error" id="c-name-err" hidden></p>
        </div>
        <div class="form-field">
          <label for="c-company">Entreprise <span class="muted">(optionnel)</span></label>
          <input type="text" id="c-company" name="company" autocomplete="organization">
        </div>
      </div>
      <div class="form-field">
        <label for="c-email">Adresse e-mail <span aria-hidden="true">*</span></label>
        <input type="email" id="c-email" name="email" autocomplete="email" required aria-describedby="c-email-err">
        <p class="field-error" id="c-email-err" hidden></p>
      </div>
      <div class="form-row">
        <div class="form-field">
          <label for="c-type">Type de projet</label>
          <select id="c-type" name="projectType">
            <% PROJECT_TYPES.forEach(function(t){ %><option value="<%= t %>"><%= t %></option><% }); %>
          </select>
        </div>
        <div class="form-field">
          <label for="c-budget">Budget estimé <span class="muted">(optionnel)</span></label>
          <select id="c-budget" name="budget">
            <option value="">Je préfère ne pas préciser</option>
            <option value="< 500 €">Moins de 500 €</option>
            <option value="500 – 1 200 €">500 – 1 200 €</option>
            <option value="1 200 – 2 500 €">1 200 – 2 500 €</option>
            <option value="> 2 500 €">Plus de 2 500 €</option>
          </select>
        </div>
      </div>
      <div class="form-field">
        <label for="c-message">Votre projet <span aria-hidden="true">*</span></label>
        <textarea id="c-message" name="message" rows="5" required aria-describedby="c-message-err" placeholder="Décrivez votre activité, vos objectifs et ce que vous attendez…"></textarea>
        <p class="field-error" id="c-message-err" hidden></p>
      </div>
      <div class="form-field checkbox">
        <input type="checkbox" id="c-consent" name="consent" required aria-describedby="c-consent-err">
        <label for="c-consent">J’accepte que mes informations soient utilisées pour traiter ma demande, conformément à la <a href="/politique-de-confidentialite">politique de confidentialité</a>. <span aria-hidden="true">*</span></label>
      </div>
      <p class="field-error" id="c-consent-err" hidden></p>
      <button type="submit" class="btn btn-primary btn-block" id="contact-submit">
        <span class="btn-label">Envoyer ma demande</span>
        <span class="btn-spinner" aria-hidden="true"></span>
      </button>
      <p class="form-error-global" id="contact-error" role="alert" hidden></p>
    </form>
  </div>
</section>

<%- include('partials/footer') %>
