<%- include('partials/head', { page }) %>
<%- include('partials/header') %>
<main id="contenu">
  <section class="section">
    <div class="container">
      <header class="section-head reveal">
        <p class="eyebrow">GUIDES</p>
        <h1>Comprendre avant de <span class="text-red">signer</span>.</h1>
        <p class="section-sub">Ce que nous savons du métier de la création web et de l’IA appliquée aux PME, écrit pour servir aussi à ceux qui ne nous commanderont jamais rien. Nos propres tarifs y figurent — c’est la seule partie subjective.</p>
      </header>
      <div class="cards-3">
        <% GUIDES.forEach(function (g) { %>
        <article class="card why-card tilt-soft reveal-3d spotlight">
          <p class="eyebrow">GUIDE</p>
          <h3><%= g.title %></h3>
          <p class="muted small"><%= g.lede %></p>
          <p><a class="btn btn-outline btn-sm" href="/guides/<%= g.slug %>">Lire le guide</a></p>
        </article>
        <% }); %>
      </div>
    </div>
  </section>
  <section class="section section-alt">
    <div class="container">
      <p class="cta-row">
        <a href="/#offres" class="btn btn-primary">Voir nos offres</a>
        <a href="/#contact" class="btn btn-ghost">Poser une question directe</a>
      </p>
    </div>
  </section>
</main>
<%- include('partials/footer') %>
